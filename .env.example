# Entorno
APP_ENV=production
LOG_LEVEL=INFO

# Odoo (XML-RPC, solo lectura).
# Con Docker y Odoo en el mismo servidor: http://host.docker.internal:8079
# Sin Docker (uvicorn directo):           http://127.0.0.1:8079
# Evitar la IP de la LAN del servidor: puede cambiar por DHCP.
ODOO_URL=https://CAMBIAR
ODOO_DB=CAMBIAR
ODOO_USERNAME=CAMBIAR
# API Key de Odoo (Preferencias -> API Keys); no la contraseña
ODOO_PASSWORD=CAMBIAR

# Telegram (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=CAMBIAR
# polling = localhost (pruebas). webhook = producción (requiere dominio y TELEGRAM_WEBHOOK_SECRET)
TELEGRAM_MODE=polling
# openssl rand -hex 32  (solo modo webhook)
TELEGRAM_WEBHOOK_SECRET=
BOT_PUBLIC_DOMAIN=

# URL HTTPS pública que abre la Mini App (túnel cloudflared en pruebas; dominio en producción).
WEBAPP_BASE_URL=https://CAMBIAR

# HTTPS público del escáner (/scanner) que sirve este validador (túnel al puerto 8011 en pruebas).
SCANNER_BASE_URL=https://CAMBIAR

# Bot de pasajeros (mismo VPS): aviso de abordaje al pasajero. Vacío = desactivado.
# El token interno se lee de bot.telegram.config (campo internal_token).
# Con Docker: http://host.docker.internal:8010 (el bot debe escuchar fuera de 127.0.0.1;
# ver README, "Acceso del contenedor a servicios del host"). Sin Docker: http://127.0.0.1:8010
BOARDING_BOT_INTERNAL_URL=http://host.docker.internal:8010

# Servidor
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8011

# Sondeo y estado
POLL_INTERVAL_SECONDS=15
WATCH_TTL_HOURS=24
EMPLOYEE_CACHE_SECONDS=300

# Estado de vigilancias: SQLite en desarrollo, PostgreSQL en Docker/producción.
# Al correr con docker-compose, DATABASE_URL se sobreescribe automáticamente
# apuntando al contenedor "db" (ver docker-compose.yml); esta línea solo
# aplica cuando se corre el bot directamente con uvicorn (sin Docker).
DATABASE_URL=sqlite:///run/watches.sqlite3

# Contraseña del usuario "watcher" de PostgreSQL (solo la usa docker-compose).
POSTGRES_PASSWORD=CAMBIAR

# ── Preoperacional (Mini App /preoperacional) — ver docs/PREOPERACIONAL.md ──
# API REST de Odoo (viacotur_api) para empleados/flota/extractos. Vacío = ODOO_URL.
ODOO_API_URL=
# Usuario con CONTRASEÑA real (/api/authenticate no acepta API keys). Vacíos = sin sincronización maestra.
ODOO_API_LOGIN=
ODOO_API_PASSWORD=
# Compañías (res.company) a sincronizar, separadas por coma.
ODOO_API_COMPANY_IDS=1
ODOO_API_PAGE_SIZE=500
ODOO_API_TIMEOUT_SECONDS=60
MASTER_SYNC_INTERVAL_SECONDS=300

# Usuario XML-RPC que crea el preoperacional. Vacíos = ODOO_USERNAME / ODOO_PASSWORD.
ODOO_WRITE_USERNAME=
ODOO_WRITE_PASSWORD=

# Cola de envío a Odoo
PREOP_WORKER_INTERVAL_SECONDS=10
PREOP_MAX_ATTEMPTS=8
PREOP_SENDING_LEASE_SECONDS=300
# Antigüedad máxima de initData para el formulario (es largo: 1 h).
PREOP_AUTH_MAX_AGE_SECONDS=3600
# HTTPS público que sirve /preoperacional. Vacío = SCANNER_BASE_URL (mismo servicio).
PREOP_BASE_URL=

# Prueba de Ruta: acuerdos (agreement) autorizados, separados por ";"; se validan contra el
# contrato del extracto aprobado y vigente del conductor. Se comparan sin
# mayúsculas, tildes ni puntuación. Agregar un contrato = sumarlo aquí y reiniciar.
PRUEBA_RUTA_ACUERDOS=MINERA DE COBRE QUEBRADONA;SERVICIOS HIDROGEOLÓGICOS INTEGRALES S.A.S.

# GPS
GPS_FLOTA_URL=http://31.97.98.223:8081/api/v1/external/flota
# Clave de la API GPS (cabecera x-api-key). Nunca la escribas aquí: solo en .env.
GPS_FLOTA_API_KEY=
GPS_FLOTA_TIMEOUT_SECONDS=10